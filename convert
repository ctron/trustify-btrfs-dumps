#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "Usage: $0 <dump-id>"
    echo ""
    echo "  dump-id   Timestamp ID of the trustify dump (e.g. 20260303T120545Z)"
    echo ""
    echo "  Environment variables:"
    echo "    STORAGE_ARCHIVE   Name of the storage tar archive, optionally compressed (default: dump.tar)"
    echo "    DB_ARCHIVE        Name of the DB SQL dump archive (default: dump.sql.xz)"
    echo "    STRIP_COMPONENTS  Number of leading path components to strip when extracting storage archive (default: none)"
    exit 1
}

if [[ $# -lt 1 ]]; then
    usage
fi

DUMP_ID="$1"
STORAGE_ARCHIVE="${STORAGE_ARCHIVE:-dump.tar}"
DB_ARCHIVE="${DB_ARCHIVE:-dump.sql.xz}"
STRIP_COMPONENTS="${STRIP_COMPONENTS:-}"
S3_BUCKET="${S3_BUCKET:-trustify-dumps-ds4}"
S3_REGION="${S3_REGION:-eu-west-1}"
BASE_URL="https://${S3_BUCKET}.s3.${S3_REGION}.amazonaws.com/${DUMP_ID}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOWNLOAD_DIR="${SCRIPT_DIR}/download"
BTRFS_IMG="${SCRIPT_DIR}/btrfs.img"
BTRFS_MNT="${SCRIPT_DIR}/mnt"

PG_VERSION="${PG_VERSION:-17}"
PG_DB="${PG_DB:-trustify}"
PG_USER="${PG_USER:-trustify}"
PG_CONTAINER="trustify-pg-import"

BTRFS_SIZE="100G"
LOOP_DEV=""

cleanup() {
    podman rm -f "${PG_CONTAINER}" 2>/dev/null || true
    if [[ -n "${LOOP_DEV}" ]]; then
        if mountpoint -q "${BTRFS_MNT}" 2>/dev/null; then
            btrfs subvolume delete "${BTRFS_MNT}/snapshot" 2>/dev/null || true
            btrfs subvolume delete "${BTRFS_MNT}/data"     2>/dev/null || true
            umount "${BTRFS_MNT}"
        fi
        losetup -d "${LOOP_DEV}" 2>/dev/null || true
    fi
    rm -rf "${BTRFS_MNT}" "${BTRFS_IMG}"
}
trap cleanup EXIT

echo "==> Downloading trustify dump: ${DUMP_ID}"

mkdir -p "${DOWNLOAD_DIR}"

download() {
    local dest="${DOWNLOAD_DIR}/$1"
    local tmp="${dest}.tmp"
    local etag_file="${dest}.etag"

    local remote_etag
    remote_etag="$(curl --fail --silent --head "${BASE_URL}/$1" | awk '/^[Ee][Tt][Aa][Gg]:/{print $2}' | tr -d '\r')"

    if [[ -f "${dest}" && -f "${etag_file}" && "$(cat "${etag_file}")" == "${remote_etag}" ]]; then
        echo "  ${1}: up to date, skipping"
        return
    fi

    curl --fail --location \
        -o "${tmp}" \
        "${BASE_URL}/$1"
    mv "${tmp}" "${dest}"
    echo "${remote_etag}" > "${etag_file}"
}

download "${STORAGE_ARCHIVE}"
download "${DB_ARCHIVE}"

echo "==> Setting up btrfs loopback volume"

truncate -s "${BTRFS_SIZE}" "${BTRFS_IMG}"
mkfs.btrfs -f "${BTRFS_IMG}"

LOOP_DEV="$(losetup --find --show "${BTRFS_IMG}")"

mkdir -p "${BTRFS_MNT}"
mount -o loop,noatime,ssd "${LOOP_DEV}" "${BTRFS_MNT}"

echo "==> btrfs volume mounted at ${BTRFS_MNT} (loop device: ${LOOP_DEV})"

btrfs subvolume create "${BTRFS_MNT}/data"
mkdir -p "${BTRFS_MNT}/data/storage" "${BTRFS_MNT}/data/db"
chown 999:999 "${BTRFS_MNT}/data/db"

echo "==> Starting PostgreSQL ${PG_VERSION} container"

podman run -d \
    --name "${PG_CONTAINER}" \
    -e POSTGRES_DB="${PG_DB}" \
    -e POSTGRES_USER="${PG_USER}" \
    -e POSTGRES_PASSWORD=trustify \
    -e PGDATA=/pgdata \
    -v "${BTRFS_MNT}/data/db:/pgdata:z" \
    "docker.io/postgres:${PG_VERSION}" \
    -c synchronous_commit=off \
    -c maintenance_work_mem=1GB \
    -c max_wal_size=4GB \
    -c checkpoint_completion_target=0.9

echo "==> Waiting for PostgreSQL to be ready"

for i in $(seq 30); do
    if podman exec "${PG_CONTAINER}" pg_isready -U "${PG_USER}" -d "${PG_DB}" &>/dev/null; then
        break
    fi
    if [[ "${i}" -eq 30 ]]; then
        echo "Error: PostgreSQL did not become ready in time" >&2
        exit 1
    fi
    sleep 2
done

podman exec "${PG_CONTAINER}" psql -U "${PG_USER}" -d "${PG_DB}" -c "CREATE ROLE postgres SUPERUSER LOGIN;"

echo "==> Importing ${DB_ARCHIVE}"

case "${DB_ARCHIVE}" in
    *.xz)  decompress="xz --decompress --stdout" ;;
    *.gz)  decompress="gzip --decompress --stdout" ;;
    *)     decompress="cat" ;;
esac

${decompress} "${DOWNLOAD_DIR}/${DB_ARCHIVE}" \
    | podman exec -i "${PG_CONTAINER}" psql -U "${PG_USER}" -d "${PG_DB}"

echo "==> Running VACUUM ANALYZE"

podman exec "${PG_CONTAINER}" psql -U "${PG_USER}" -d "${PG_DB}" -c "VACUUM ANALYZE;"

echo "==> Stopping PostgreSQL container"

podman stop "${PG_CONTAINER}"
podman rm "${PG_CONTAINER}"

echo "==> Extracting dump.tar into btrfs volume"

TAR_ARGS=(-xaf "${DOWNLOAD_DIR}/${STORAGE_ARCHIVE}" -C "${BTRFS_MNT}/data/storage")
[[ -n "${STRIP_COMPONENTS}" ]] && TAR_ARGS+=(--strip-components="${STRIP_COMPONENTS}")
tar "${TAR_ARGS[@]}"

echo "==> Creating readonly snapshot"

SNAPSHOT="${BTRFS_MNT}/snapshot"
btrfs subvolume snapshot -r "${BTRFS_MNT}/data" "${SNAPSHOT}"

echo "==> Creating FS archive"

SEND_ARCHIVE="${SCRIPT_DIR}/${DUMP_ID}.btrfs.zstd"
btrfs send "${SNAPSHOT}" | zstd -5 -T0 > "${SEND_ARCHIVE}"

echo "==> btrfs send archive written to: ${SEND_ARCHIVE}"

sha256sum "${SEND_ARCHIVE}" > "${SEND_ARCHIVE}.sha256"
echo "==> SHA256 checksum written to: ${SEND_ARCHIVE}.sha256"

# TODO: Upload / publish the resulting btrfs snapshot

echo "==> Done."
