#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "Usage: $0 <dump-id>"
    echo ""
    echo "  dump-id   Timestamp ID of the trustify dump (e.g. 20260303T120545Z)"
    exit 1
}

if [[ $# -lt 1 ]]; then
    usage
fi

if [[ "${EUID}" -ne 0 ]]; then
    echo "Error: this script must be run as root" >&2
    exit 1
fi

DUMP_ID="$1"
BASE_URL="https://trustify-dumps-ds4.s3.eu-west-1.amazonaws.com/${DUMP_ID}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOWNLOAD_DIR="${SCRIPT_DIR}/download"
BTRFS_IMG="${SCRIPT_DIR}/btrfs.img"
BTRFS_MNT="${SCRIPT_DIR}/mnt"

PG_VERSION="${PG_VERSION:-16}"
PG_DB="${PG_DB:-trustify}"
PG_USER="${PG_USER:-trustify}"
PG_DATA="${BTRFS_MNT}/storage/postgresql"
PG_SOCKET_DIR="${SCRIPT_DIR}/pg-socket"

LOOP_DEV=""

cleanup() {
    if pg_lsclusters -h 2>/dev/null | grep -q "^${PG_VERSION}"; then
        pg_ctlcluster "${PG_VERSION}" trustify stop 2>/dev/null || true
        pg_dropcluster "${PG_VERSION}" trustify 2>/dev/null || true
    fi
    rm -rf "${PG_SOCKET_DIR}"
    if [[ -n "${LOOP_DEV}" ]]; then
        if mountpoint -q "${BTRFS_MNT}" 2>/dev/null; then
            btrfs subvolume delete "${BTRFS_MNT}/snapshot" 2>/dev/null || true
            btrfs subvolume delete "${BTRFS_MNT}/storage"  2>/dev/null || true
            umount "${BTRFS_MNT}"
        fi
        losetup -d "${LOOP_DEV}" 2>/dev/null || true
    fi
    rm -rf "${DOWNLOAD_DIR}" "${BTRFS_MNT}" "${BTRFS_IMG}"
}
trap cleanup EXIT

echo "==> Downloading trustify dump: ${DUMP_ID}"

mkdir -p "${DOWNLOAD_DIR}"

download() {
    local dest="${DOWNLOAD_DIR}/$1"
    local tmp="${dest}.tmp"
    local etag_file="${dest}.etag"

    local remote_etag
    remote_etag="$(curl --fail --silent --head "${BASE_URL}/$1" | awk '/^[Ee][Tt][Aa][Gg]:/{print $2}' | tr -d '\r')"

    if [[ -f "${dest}" && -f "${etag_file}" && "$(cat "${etag_file}")" == "${remote_etag}" ]]; then
        echo "  ${1}: up to date, skipping"
        return
    fi

    curl --fail --location \
        -o "${tmp}" \
        "${BASE_URL}/$1"
    mv "${tmp}" "${dest}"
    echo "${remote_etag}" > "${etag_file}"
}

download dump.tar
download dump.sql.xz

echo "==> Setting up btrfs loopback volume"

BTRFS_SIZE="20G"
truncate -s "${BTRFS_SIZE}" "${BTRFS_IMG}"
mkfs.btrfs -f "${BTRFS_IMG}"

LOOP_DEV="$(losetup --find --show "${BTRFS_IMG}")"

mkdir -p "${BTRFS_MNT}"
mount -o loop,noatime,ssd "${LOOP_DEV}" "${BTRFS_MNT}"

echo "==> btrfs volume mounted at ${BTRFS_MNT} (loop device: ${LOOP_DEV})"

echo "==> Extracting dump.tar into btrfs volume"

btrfs subvolume create "${BTRFS_MNT}/storage"
tar -xf "${DOWNLOAD_DIR}/dump.tar" -C "${BTRFS_MNT}/storage"

echo "==> Starting temporary PostgreSQL ${PG_VERSION} instance"

mkdir -p "${PG_SOCKET_DIR}"
pg_createcluster "${PG_VERSION}" trustify \
    --datadir="${PG_DATA}" \
    -- \
    -c unix_socket_directories="${PG_SOCKET_DIR}" \
    -c listen_addresses=''

pg_ctlcluster "${PG_VERSION}" trustify start

runuser -u postgres -- createuser --host="${PG_SOCKET_DIR}" "${PG_USER}" 2>/dev/null || true
runuser -u postgres -- createdb  --host="${PG_SOCKET_DIR}" --owner="${PG_USER}" "${PG_DB}"

echo "==> Importing dump.sql.xz"

xz --decompress --stdout "${DOWNLOAD_DIR}/dump.sql.xz" \
    | runuser -u postgres -- psql --host="${PG_SOCKET_DIR}" "${PG_DB}"

echo "==> Stopping PostgreSQL"

pg_ctlcluster "${PG_VERSION}" trustify stop

echo "==> Creating readonly snapshot and sending archive"

SNAPSHOT="${BTRFS_MNT}/snapshot"
btrfs subvolume snapshot -r "${BTRFS_MNT}/storage" "${SNAPSHOT}"

SEND_ARCHIVE="${SCRIPT_DIR}/${DUMP_ID}.btrfs.xz"
btrfs send "${SNAPSHOT}" | xz --threads=0 > "${SEND_ARCHIVE}"

echo "==> btrfs send archive written to: ${SEND_ARCHIVE}"

# TODO: Upload / publish the resulting btrfs snapshot

echo "==> Done."
